{
  "name": "adroom-backend",
  "version": "1.0.0",
  "description": "Real-time backend for AdRoom automation and webhooks",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "test:whatsapp-pairing": "npm run build && node dist/services/whatsappPairing.test.js",
    "test:contracts": "npm run build && node dist/agentFrameworkContract.test.js",
    "test:public-profile": "npm run build && node dist/services/publicProfileToolAdapters.test.js && node dist/leadProfileBuilderMigration.test.js",
    "smoke:production": "npm run build && node dist/productionSmoke.js",
    "check:migrations": "npm run build && node dist/productionMigrationCheck.js",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "worker": "ts-node src/worker.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@supabase/supabase-js": "^2.98.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.13.6",
    "body-parser": "^1.20.4",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.4.0",
    "openai": "^4.104.0",
    "pg": "^8.20.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
